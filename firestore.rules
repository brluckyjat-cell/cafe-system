rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products & Categories: Customers can view, Admin can edit
    match /products/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /categories/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Orders: Customers can create & track status, Admin full control
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if true;
      allow delete: if request.auth != null;
    }
    
    // Offers & Cafe Settings: Public read, Admin edit
    match /offers/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin-Only Collections (Expenses, Inventory, Sales, Customers)
    match /expenses/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /inventory/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /customers/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /sales/{document} {
      allow read, write: if request.auth != null;
    }

    match /users/{document} {
      allow read, write: if request.auth != null;
    }

    match /admin/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
